# ===================== 必填 =====================
# 随机长字符串，用于 session 签名和数据加密；可用下面的命令生成：
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===================== 运行参数 =====================
DATA_DIR=/data
PORT=8080
HOST_PORT=8080
TZ=Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai
# 使用 HTTPS 反向代理后建议改为 true
SESSION_COOKIE_SECURE=false

# ===================== SMTP 默认配置 =====================
# 这些值可以在 Web 设置页覆盖；留空则只保存 EPUB 和原始数据归档，不发送邮件。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=知乎收藏
SMTP_TO=

# ===================== 测试选项 =====================
# off / success / empty / fail。非 off 时不会访问知乎，仅供流程测试。
PIPELINE_STUB=off

# ===================== Docker 构建（可选） =====================
# BASE_IMAGE=python:3.12-slim
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
