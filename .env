# ===================== 必填 =====================
# 本地开发用的默认配置；正式部署前请更换 SECRET_KEY 和 ADMIN_PASSWORD。
SECRET_KEY=e1M0BaZAExRAnMXkdwwr0YGlAjXQsb2mX9Ql3a73bakC6NCBI3Ub1R-FGI_vWb6T
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===================== 运行参数 =====================
# 本地直接运行（python run.py）时数据写到当前目录下的 data/
# Docker 运行时会用 docker-compose.yml 里的 environment 覆盖为 /data
DATA_DIR=./data
PORT=8080
HOST_PORT=8080
TZ=Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai
# 使用 HTTPS 反向代理后建议改为 true
SESSION_COOKIE_SECURE=false

# ===================== SMTP 默认配置 =====================
# 这些值可以在 Web 设置页覆盖；留空则只保存 EPUB，不发送邮件。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=知乎收藏
SMTP_TO=

# ===================== 测试选项 =====================
# off / success / empty / fail。非 off 时不会访问知乎，仅供流程测试。
PIPELINE_STUB=off
